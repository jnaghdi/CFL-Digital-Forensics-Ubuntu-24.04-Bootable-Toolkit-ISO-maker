#!no-recommends
# GNOME desktop (vanilla session on Xorg), macOS theme toolchain & workstation apps.
# Ubuntu's gnome-core pulls snapd + ubuntu-session; we install the pieces
# explicitly instead and keep everything snap-free.
gnome-session gnome-shell gnome-shell-extensions gdm3
gnome-control-center gnome-tweaks gnome-shell-extension-manager
nautilus gnome-terminal gnome-text-editor gnome-system-monitor
gnome-disk-utility gnome-calculator baobab seahorse eog evince file-roller
gnome-keyring gnome-menus gnome-backgrounds yaru-theme-gtk yaru-theme-icon
xdg-desktop-portal-gnome xdg-user-dirs xdg-user-dirs-gtk

# GNOME Shell extensions used by the CFL layout (Dash-to-Dock -> ubuntu-dock,
# ArcMenu comes from extensions.gnome.org via the theme hook)
gnome-shell-extension-ubuntu-dock gnome-shell-extension-appindicator
gnome-shell-extension-desktop-icons-ng

# Xorg (root/legacy forensic GUI tools behave best on X11)
xorg xserver-xorg-legacy xinit x11-xserver-utils

# Networking, audio, Bluetooth
network-manager network-manager-gnome
pipewire pipewire-pulse wireplumber
bluez gnome-bluetooth-sendto

# Terminal engine used by every CFL tool launcher (Parrot uses mate-terminal)
mate-terminal

# Workstation applications
# NB: Firefox and Thunderbird are NOT listed here - in the Ubuntu archive
# they are snap stubs (PreDepends: snapd, which we pin out). They are
# installed as real .debs from the Mozilla APT repo in build.sh's
# desktop stage instead.
libreoffice-writer libreoffice-calc
vlc cherrytree gimp gtkhash keepassxc

# Fonts (Inter / JetBrains Mono for the WhiteSur look; Powerline for the prompt)
fonts-inter fonts-jetbrains-mono fonts-powerline
fonts-dejavu fonts-liberation2 fonts-noto-core fonts-noto-color-emoji

# Theme build toolchain (WhiteSur installer needs these)
sassc libglib2.0-bin libglib2.0-dev-bin libxml2-utils imagemagick optipng dialog

# Base developer/runtime tooling
git curl wget ca-certificates gnupg
python3-pip pipx python3-venv build-essential dkms
openjdk-21-jre default-jre-headless
zsh udisks2 gvfs gvfs-backends gvfs-fuse
unzip p7zip-full xdg-utils dconf-cli dconf-gsettings-backend
polkitd polkitd-pkla pkexec
