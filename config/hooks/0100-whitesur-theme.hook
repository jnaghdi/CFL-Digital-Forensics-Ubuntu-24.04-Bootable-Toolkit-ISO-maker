#!/bin/bash
# CFL Forensics - install the WhiteSur macOS theme family (GTK, shell, icons, cursors, wallpapers)
set -e
echo "=== [theme] WhiteSur macOS theme installation ==="
export DEBIAN_FRONTEND=noninteractive
mkdir -p /var/log/cfl-forensics
exec > >(tee -a /var/log/cfl-forensics/theme.log) 2>&1

warn() { echo "WARN [theme] $* (non-fatal, build continues)"; }

# WhiteSur's installer libs resolve a username at source time
# (lib-core.sh: MY_USERNAME from SUDO_USER/logname/USER, then getent).
# Inside live-build's chroot none of those resolve, getent fails, and the
# script's own 'set -Eeo pipefail' aborts it silently before any output.
# Give the scripts a concrete identity before calling any of them.
export USER=root
export LOGNAME=root
export HOME=/root
unset SUDO_USER

apt-get update
apt-get install -y --no-install-recommends \
    sassc libglib2.0-bin libglib2.0-dev-bin libxml2-utils \
    imagemagick optipng dialog git ca-certificates curl

WORK=/tmp/whitesur
rm -rf "$WORK"; mkdir -p "$WORK"; cd "$WORK"

git clone --depth=1 https://github.com/vinceliuice/WhiteSur-gtk-theme.git
git clone --depth=1 https://github.com/vinceliuice/WhiteSur-icon-theme.git
git clone --depth=1 https://github.com/vinceliuice/WhiteSur-cursors.git
git clone --depth=1 https://github.com/vinceliuice/WhiteSur-wallpapers.git || warn "wallpapers clone"

# --- GTK theme (core - must succeed) ---
cd "$WORK/WhiteSur-gtk-theme"
if ! ./install.sh -t all -c Dark -c Light </dev/null; then
    echo "WARN [theme] full-variant install failed - retrying with minimal flags"
    ./install.sh -c Dark -c Light </dev/null
fi

# --- Shell theme extras, GDM and libadwaita (nice to have) ---
./install.sh --shell -i apple </dev/null || warn "GNOME Shell apple activities icon"
./install.sh -N mojave </dev/null           || warn "Nautilus mojave style"
./tweaks.sh -g </dev/null                   || warn "GDM login screen theme"
./install.sh -l -c Dark </dev/null          || warn "libadwaita gtk4 theme"
mkdir -p /etc/skel/.config
cp -r /root/.config/gtk-4.0 /etc/skel/.config/ 2>/dev/null || true

# --- icons ---
cd "$WORK/WhiteSur-icon-theme"
./install.sh -t all </dev/null || warn "icon theme"

# --- cursors (system-wide) ---
cd "$WORK/WhiteSur-cursors"
if [ -d dist ]; then
    cp -r dist /usr/share/icons/WhiteSur-cursors || warn "cursor copy"
else
    ./install.sh </dev/null || warn "cursor install.sh"
    [ -d /root/.icons/WhiteSur-cursors ] && cp -r /root/.icons/WhiteSur-cursors /usr/share/icons/ || true
fi
mkdir -p /etc/skel/.icons
[ -d /usr/share/icons/WhiteSur-cursors ] && cp -r /usr/share/icons/WhiteSur-cursors /etc/skel/.icons/ || true

# --- wallpapers ---
BG=/usr/share/backgrounds/cfl-forensics
mkdir -p "$BG"
if [ -d "$WORK/WhiteSur-wallpapers" ]; then
    cd "$WORK/WhiteSur-wallpapers"
    SRC=.
    [ -d 4k ] && SRC=4k
    find "$SRC" -type f \( -iname '*.jpg' -o -iname '*.png' \) \
        -iregex '.*\(ventura\|monterey\|bigsur\|big.sur\|sonoma\|catalina\|mojave\|sequoia\).*' \
        -exec cp -t "$BG" {} + || true
    if [ -z "$(ls -A "$BG" 2>/dev/null)" ]; then
        find . -type f \( -iname '*.jpg' -o -iname '*.png' \) -exec cp -t "$BG" {} + || true
    fi
fi
DARK=$(find "$BG" -type f | grep -i dark | grep -Ei 'ventura|monterey|bigsur|sonoma|sequoia' | head -1)
[ -z "$DARK" ] && DARK=$(find "$BG" -type f | grep -i dark | head -1)
LIGHT=$(find "$BG" -type f | grep -i light | grep -Ei 'ventura|monterey|bigsur|sonoma|catalina' | head -1)
[ -z "$LIGHT" ] && LIGHT=$(find "$BG" -type f | grep -i light | head -1)
[ -z "$DARK" ]  && DARK=$(find "$BG" -type f | head -1)
[ -z "$LIGHT" ] && LIGHT="$DARK"
[ -n "$DARK" ]  && cp "$DARK"  "$BG/default-dark.jpg"
[ -n "$LIGHT" ] && cp "$LIGHT" "$BG/default.jpg"
# last-resort generated gradients so the dconf keys always resolve
[ -f "$BG/default.jpg" ]      || convert -size 5120x2880 gradient:'#3a7bd5-#00d2ff' "$BG/default.jpg"
[ -f "$BG/default-dark.jpg" ] || convert -size 5120x2880 gradient:'#141e30-#243b55' "$BG/default-dark.jpg"

cd /
rm -rf "$WORK"
echo "=== [theme] done ==="

# ============================================================================
# ArcMenu - Ubuntu does not package gnome-shell-extension-arc-menu, so install
# it from the official GitLab release into the system extensions directory
# (matched to the running GNOME Shell major version). The dconf defaults in
# 01-cfl-forensics already enable arcmenu@arcmenu.com and style the button.
# ============================================================================
echo "=== [theme] ArcMenu (from upstream, not in the Ubuntu archive) ==="
SHELL_MAJOR=$(gnome-shell --version 2>/dev/null | grep -oE '[0-9]+' | head -1)
ARC_UUID="arcmenu@arcmenu.com"
ARC_DIR="/usr/share/gnome-shell/extensions/$ARC_UUID"
ARC_STATUS=/usr/share/cfl-forensics/ARCMENU-STATUS.txt
mkdir -p "$(dirname "$ARC_STATUS")"
rm -rf "$ARC_DIR"; mkdir -p "$ARC_DIR"
arc_ok=0

# Does a metadata.json declare support for our GNOME Shell major version?
arc_supports_shell() {   # arc_supports_shell <metadata.json>
    [ -n "$SHELL_MAJOR" ] || return 0     # unknown shell: accept
    python3 - "$1" "$SHELL_MAJOR" <<'PYEOF' 2>/dev/null
import json,sys
m=json.load(open(sys.argv[1])); want=sys.argv[2]
vers=[str(v).split('.')[0] for v in m.get('shell-version',[])]
sys.exit(0 if want in vers else 1)
PYEOF
}

# --- 1. extensions.gnome.org: ask for the release built for THIS shell ------
# The download URL needs a version_tag; the extension-info API gives us the
# right one for a given shell_version.
if [ -n "$SHELL_MAJOR" ]; then
    info_json=$(curl -fsSL --retry 3 \
        "https://extensions.gnome.org/extension-info/?uuid=${ARC_UUID}&shell_version=${SHELL_MAJOR}" 2>/dev/null || true)
    dl=$(printf '%s' "$info_json" | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("download_url",""))
except Exception:
    print("")' 2>/dev/null)
    if [ -n "$dl" ]; then
        if curl -fsSL --retry 3 -o /tmp/arcmenu.zip "https://extensions.gnome.org${dl}" \
           && unzip -q -o /tmp/arcmenu.zip -d "$ARC_DIR" 2>/dev/null \
           && [ -f "$ARC_DIR/metadata.json" ] && arc_supports_shell "$ARC_DIR/metadata.json"; then
            arc_ok=1
            echo "ArcMenu: extensions.gnome.org build for GNOME Shell $SHELL_MAJOR"
        else
            rm -rf "${ARC_DIR:?}"/*
        fi
    fi
fi

# --- 2. GitLab fallback: pick the newest TAG whose metadata supports our shell
if [ "$arc_ok" -ne 1 ]; then
    if git clone -q https://gitlab.com/arcmenu/ArcMenu.git /tmp/ArcMenu 2>/dev/null; then
        chosen=""
        for tag in $(git -C /tmp/ArcMenu tag --sort=-v:refname 2>/dev/null | head -40); do
            git -C /tmp/ArcMenu checkout -q "$tag" 2>/dev/null || continue
            [ -f /tmp/ArcMenu/metadata.json ] || continue
            if arc_supports_shell /tmp/ArcMenu/metadata.json; then chosen="$tag"; break; fi
        done
        if [ -n "$chosen" ]; then
            # ArcMenu's Makefile installs to $INSTALLBASE/<uuid>
            if [ -f /tmp/ArcMenu/Makefile ]; then
                make -C /tmp/ArcMenu install INSTALLBASE=/usr/share/gnome-shell/extensions >/dev/null 2>&1 || true
            fi
            # or copy the tree directly (schemas compiled below)
            if [ ! -f "$ARC_DIR/metadata.json" ]; then
                cp -r /tmp/ArcMenu/. "$ARC_DIR/" 2>/dev/null || true
                rm -rf "$ARC_DIR/.git"
            fi
            [ -f "$ARC_DIR/metadata.json" ] && { arc_ok=1; echo "ArcMenu: GitLab tag $chosen (supports GNOME Shell $SHELL_MAJOR)"; }
        else
            echo "ArcMenu: no GitLab tag declares support for GNOME Shell $SHELL_MAJOR"
        fi
    fi
fi

if [ "$arc_ok" -eq 1 ]; then
    # compile the extension's gsettings schema (needed for the dconf styling
    # keys in 01-cfl-forensics to resolve), both in-tree and system-wide
    if [ -d "$ARC_DIR/schemas" ]; then
        glib-compile-schemas "$ARC_DIR/schemas" >/dev/null 2>&1 || true
        cp "$ARC_DIR"/schemas/*.gschema.xml /usr/share/glib-2.0/schemas/ 2>/dev/null || true
        glib-compile-schemas /usr/share/glib-2.0/schemas/ >/dev/null 2>&1 || true
    fi
    chmod -R a+rX "$ARC_DIR"
    ver=$(python3 -c 'import json;print(json.load(open("'"$ARC_DIR"'/metadata.json")).get("version","?"))' 2>/dev/null)
    echo "OK   [theme] ArcMenu v${ver} installed for GNOME Shell ${SHELL_MAJOR}"
    printf 'ArcMenu: INSTALLED (version %s) for GNOME Shell %s\n' "$ver" "$SHELL_MAJOR" > "$ARC_STATUS"
else
    echo "WARN [theme] ArcMenu could not be installed - the app grid folders (see dconf app-folders) still give a categorised CFL menu"
    printf 'ArcMenu: NOT INSTALLED - the CFL menu is provided by GNOME app-grid folders instead\n' > "$ARC_STATUS"
    rm -rf "$ARC_DIR"
fi
rm -rf /tmp/arcmenu.zip /tmp/ArcMenu
